      "get": {
        "tags": [
          "Autosuggest Settings"
        ],
        "summary": "Get Hotel Autosuggest settings",
        "description": "Hotel Autosuggest settings API allows to get all settings related to autosuggest including `filterPreference`, `searchPreference`, `sortPreference`, `suggestionPreference`, `indexStrategy` which will be used to show autosuggest response on the UI",
        "parameters": [
          {
            "name": "content-type",
            "in": "header",
            "description": "content type should be application/json",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accept-encoding",
            "in": "header",
            "description": "Encoding format.",
            "example": "gzip, deflate",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accept-language",
            "in": "header",
            "description": "Language accepted in the response",
            "example": "en-US",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cnx-sessionid",
            "in": "header",
            "description": "Unique ID of the user",
            "example": "50c37736-997b-42a9-b038-e64156723dfb",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
