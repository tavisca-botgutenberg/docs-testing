    "/api/autosuggest/v1.0/search/location": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Location Search By Location Id.",
        "description": "This request allows to asynchronously search Hotel,Airport,point-of-interest,City,Province Region,Neighborhood search based on the list of Location Ids passed.",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "description": "Location Id Example:- 691001",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "consumer",
            "in": "query",
            "description": "Consumer should be Hotels, Flights, Cars, Activities",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchType",
            "in": "query",
            "description": "searchType should be city, airport, point-of-interest, hotel, arrival-airport, departure-airport, neighborhood, provinceregion",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accept-encoding",
            "in": "header",
            "description": "Example : gzip, deflate",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
